# Copy to .env.local and fill in what you need. Everything is optional ,
# without an AI key the app structures notes locally.

# AI, note structuring refinement and plain-language playbook import
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Automatic MetaTrader import
METAAPI_TOKEN=
# 32+ random characters, e.g. `openssl rand -hex 32`
SYNC_SECRET=
# SYNC_MAX_ACCOUNTS=3

# Welcome answers (who your traders are): POSTs the answers as JSON to this URL
ONBOARDING_WEBHOOK_URL=

# Landing-page waitlist: POSTs {"email": "..."} as JSON to this URL
WAITLIST_WEBHOOK_URL=
