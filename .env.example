# Copy to .env.local and fill in what you need.

# Accounts and saved journals (Supabase → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server side: checks who is calling Proof's API
SUPABASE_URL=
# 1 shows "Continue with Google" once Google is switched on in Supabase
NEXT_PUBLIC_AUTH_GOOGLE=

# AI: note structuring refinement and plain-language playbook import.
# Without it, notes are structured on the device.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Automatic MetaTrader import
METAAPI_TOKEN=
# 32+ random characters, e.g. `openssl rand -hex 32`
SYNC_SECRET=
# SYNC_MAX_ACCOUNTS=3
